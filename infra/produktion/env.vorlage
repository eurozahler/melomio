# /opt/melomio/app/.env auf dem PRODUKTIONSSERVER (Rechte 600, nie ins Git).
# Geheime Werte NICHT hier eintragen, sondern mit:  bash schluessel-eintragen.sh NAME
APP_MODE=live
APP_BASE_URL=https://melomio.de
DATABASE_URL=            # postgres://melomio:<neues Passwort>@127.0.0.1:5432/melomio
BETTER_AUTH_SECRET=      # NEU erzeugen: openssl rand -base64 48

PAYMENT_PROVIDER=mollie
MOLLIE_API_KEY=          # live_… (erst nach Freischaltung durch Mollie)

LYRICS_PROVIDER=anthropic
ANTHROPIC_API_KEY=       # eigener Schlüssel nur für den Livebetrieb

MUSIC_PROVIDER=mureka
MUREKA_API_KEY=
MUREKA_COST_CENTS=14
MUREKA_LOW_BALANCE_CENTS=2000   # Alarm unter 20 $ Guthaben

EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.strato.de
SMTP_PORT=587
SMTP_USER=hallo@melomio.de
SMTP_PASSWORD=
SMTP_FROM=melomio <hallo@melomio.de>
ALERT_EMAIL=             # wohin Alarme gehen, z. B. info@eurozahler.de

STORAGE_PROVIDER=s3
S3_ENDPOINT=https://fsn1.your-objectstorage.com   # Standort des Buckets
S3_REGION=fsn1
S3_BUCKET=melomio-live
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
