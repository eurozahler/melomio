# Vorlage für alle Umgebungsvariablen – OHNE echte Werte.
# Kopieren nach .env.local und dort ausfüllen. .env.local kommt NIE in Git.
# Geprüft wird beim Start durch src/config/env.ts.

# --- Betriebsart --------------------------------------------------------
# test = Testbetrieb (Banner sichtbar), live = echter Betrieb
APP_MODE=test

# --- Adapter (test-Werte: mock / console / local) -----------------------
PAYMENT_PROVIDER=mock      # mock | mollie
LYRICS_PROVIDER=mock       # mock | anthropic
MUSIC_PROVIDER=mock        # mock | mureka   (elevenlabs, lyria, acestep: noch nicht umgesetzt)
EMAIL_PROVIDER=console     # console | smtp
STORAGE_PROVIDER=local     # local | s3

# --- Datenbank (Pflicht) ------------------------------------------------
# Lokal über den SSH-Tunnel (scripts/db-tunnel.ps1) zum Hetzner-Testserver
DATABASE_URL=postgres://melomio:PASSWORT@localhost:5433/melomio_dev
DATABASE_URL_TEST=postgres://melomio:PASSWORT@localhost:5433/melomio_test

# --- Anmeldung (Pflicht) -----------------------------------------------
# Öffentliche Adresse ohne Pfad. Lokal http://localhost:3000, live https://melomio.de
APP_BASE_URL=http://localhost:3000
# Zufälliger Schlüssel, mind. 32 Zeichen. Erzeugen z. B. mit:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Schutz gegen zu viele Anmeldeversuche (on | off). "off" nur für automatische Tests, im Livebetrieb gesperrt.
AUTH_RATE_LIMIT=on

# --- Zahlung (nur bei PAYMENT_PROVIDER=mollie) --------------------------
# Im Testbetrieb nur test_…, im Livebetrieb nur live_…
MOLLIE_API_KEY=

# --- Songtext (nur bei LYRICS_PROVIDER=anthropic) -----------------------
ANTHROPIC_API_KEY=

# --- Musik (nur bei MUSIC_PROVIDER=mureka) ------------------------------
# Schlüssel unter https://platform.mureka.ai → API Keys (Guthaben separat von der Mureka-Webseite)
MUREKA_API_KEY=
MUREKA_MODEL=              # leer = mureka-9.5
MUREKA_COST_CENTS=         # Kosten pro Song in Cent, leer = 14 (gemessen: 0,15 $ je Song)
ELEVENLABS_API_KEY=

# --- E-Mail (nur bei EMAIL_PROVIDER=smtp, Postfach bei Strato) ----------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Audio/Video (FFmpeg) ----------------------------------------------
# Ohne Angabe: "ffmpeg"/"ffprobe" aus dem Systempfad. Windows (winget): vollständiger Pfad zur .exe
FFMPEG_PATH=
FFPROBE_PATH=
# Lokaler Dateispeicher im Testbetrieb (STORAGE_PROVIDER=local)
STORAGE_LOCAL_DIR=storage

# --- Dateispeicher (nur bei STORAGE_PROVIDER=s3, Hetzner Object Storage) -
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Veröffentlichung (C7) -------------------------------------------------------
# storage = Videos nur im eigenen Speicher ablegen (Test); dropbox = in den EasyGMV-Ordner hochladen.
PUBLISH_PROVIDER=storage
# Dropbox-App (https://www.dropbox.com/developers/apps): App key und App secret.
# Redirect-URI in der App eintragen: <APP_BASE_URL>/api/admin/dropbox/callback
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
