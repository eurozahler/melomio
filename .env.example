# Vorlage für alle Umgebungsvariablen – OHNE echte Werte.
# Kopieren nach .env.local und dort ausfüllen. .env.local kommt NIE in Git.
# Geprüft wird beim Start durch src/config/env.ts.

# --- Betriebsart --------------------------------------------------------
# test = Testbetrieb (Banner sichtbar), live = echter Betrieb
APP_MODE=test

# --- Adapter (test-Werte: mock / console / local) -----------------------
PAYMENT_PROVIDER=mock      # mock | mollie
LYRICS_PROVIDER=mock       # mock | anthropic
MUSIC_PROVIDER=mock        # mock | elevenlabs   (lyria, mureka, acestep: noch nicht umgesetzt)
EMAIL_PROVIDER=console     # console | smtp
STORAGE_PROVIDER=local     # local | s3

# --- Datenbank (Pflicht) ------------------------------------------------
# Lokal über den SSH-Tunnel (scripts/db-tunnel.ps1) zum Hetzner-Testserver
DATABASE_URL=postgres://melomio:PASSWORT@localhost:5433/melomio_dev
DATABASE_URL_TEST=postgres://melomio:PASSWORT@localhost:5433/melomio_test

# --- Zahlung (nur bei PAYMENT_PROVIDER=mollie) --------------------------
# Im Testbetrieb nur test_…, im Livebetrieb nur live_…
MOLLIE_API_KEY=

# --- Songtext (nur bei LYRICS_PROVIDER=anthropic) -----------------------
ANTHROPIC_API_KEY=

# --- Musik (nur bei MUSIC_PROVIDER=elevenlabs) --------------------------
ELEVENLABS_API_KEY=

# --- E-Mail (nur bei EMAIL_PROVIDER=smtp, Postfach bei Strato) ----------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Dateispeicher (nur bei STORAGE_PROVIDER=s3, Hetzner Object Storage) -
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
